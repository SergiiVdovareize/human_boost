{
  "manifest_version": 3,
  "name": "Human Boost",
  "version": "1.19.0",
  "key": "",
  "description": "Unofficial productivity boost for the human.ua educational platform",
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.human.ua/*"
      ],
      "js": [
        "main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.human.ua/*"
      ],
      "js": [
        "content-DaKKgI0E.js"
      ],
      "css": [
        "style-ZZlmOQJk.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/logo.svg",
        "main-world.js"
      ],
      "matches": [
        "*://*.human.ua/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.human.ua/*",
    "https://api.vdovareize.me/*"
  ]
}